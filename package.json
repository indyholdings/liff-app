{
  "name": "sidecar",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test --test-reporter=spec tests/*.test.ts",
    "test:pg": "node --test --test-concurrency=1 --test-reporter=spec tests/*.test.ts",
    "dev": "node dev/server.ts",
    "dev:gbl": "PROFILE=real_estate PORT=8788 node dev/server.ts",
    "test:ui": "node extension/dev/smoke.mjs",
    "test:e2e": "node dev/e2e.mjs",
    "test:ui:gbl": "node extension/dev/smoke-gbl.mjs",
    "test:e2e:gbl": "node dev/e2e-gbl.mjs",
    "build:brand": "node scripts/build-brand.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "postgres": "3.4.5"
  },
  "engines": {
    "node": ">=22.18"
  }
}
